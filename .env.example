# Copy this file to .env and fill in real Postgres connection strings.
# Never commit .env — it holds real database credentials.
#
# Local development: point these at a local Postgres instance, or at a
# separate (e.g. Neon/Vercel Postgres) "dev" branch/database so you're not
# developing against production data.
#
# Production (Vercel): set these as Environment Variables in the Vercel
# Project Settings instead of committing them here.
#
# DATABASE_URL — the connection the app uses at runtime. If your provider
# gives you a "pooled" connection string (e.g. Neon/Vercel Postgres,
# usually with "-pooler" in the hostname or "pgbouncer=true" in the query
# string), use that one here.
DATABASE_URL="postgresql://user:password@localhost:5432/renewaliq?schema=public"

# DIRECT_URL — a non-pooled connection to the SAME database, used only by
# `prisma migrate deploy`/`migrate dev` (schema migrations need a direct
# session and will otherwise fail with "Error: P1002 ... timed out trying
# to acquire a postgres advisory lock" through a transaction pooler).
# On a plain, non-pooled Postgres (local dev, most self-hosted setups)
# this can be identical to DATABASE_URL. On Neon/Vercel Postgres, use the
# "non-pooling" connection string (Vercel's own Postgres integration
# exposes it as POSTGRES_URL_NON_POOLING; on Neon directly, it's the
# connection string without "-pooler" in the hostname).
DIRECT_URL="postgresql://user:password@localhost:5432/renewaliq?schema=public"

# ANTHROPIC_API_KEY — optional. Powers real AI document analysis on the
# Documents tab (MVR / Driver License / Vehicle Registration / Current
# Policy extraction). Without it, the feature still works end to end —
# uploads, the file list, and the demo ABC Trucking LLC insights all work —
# but a real uploaded document will show "Automatic analysis needs an API
# key" instead of extracted fields, rather than ever inventing data.
# ANTHROPIC_API_KEY="sk-ant-..."

# ANTHROPIC_VISION_MODEL — optional override for the model used above.
# Defaults to claude-sonnet-5.
# ANTHROPIC_VISION_MODEL="claude-sonnet-5"
