# Copy this file to .env and fill in a real Postgres connection string.
# Never commit .env — it holds real database credentials.
#
# Local development: point this at a local Postgres instance, or at a
# separate (e.g. Neon/Vercel Postgres) "dev" branch/database so you're not
# developing against production data.
#
# Production (Vercel): set DATABASE_URL as an Environment Variable in the
# Vercel Project Settings instead of committing it here.
DATABASE_URL="postgresql://user:password@localhost:5432/renewaliq?schema=public"
